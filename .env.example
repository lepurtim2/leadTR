# ─────────────────────────────────────────────
# LeadTR — Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env with real secrets
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── PostgreSQL (Supabase) ────────────────────
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Redis (Upstash) ─────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Supabase Auth ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Object Storage (R2/S3) ──────────────────
S3_ENDPOINT=
S3_BUCKET=leadtr-raw
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ── Typesense ────────────────────────────────
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=

# ── Monitoring ───────────────────────────────
SENTRY_DSN=

# ── Billing ──────────────────────────────────
BILLING_SECRET=
